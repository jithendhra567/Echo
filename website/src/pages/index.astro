---
import Layout     from '../layouts/Layout.astro';
import Nav        from '../components/Nav.astro';
import Hero       from '../components/Hero.astro';
import Features   from '../components/Features.astro';
import Demo          from '../components/Demo.astro';
import NotchShowcase from '../components/NotchShowcase.astro';
import Productivity  from '../components/Productivity.astro';
import Download   from '../components/Download.astro';
import Footer     from '../components/Footer.astro';
import '../styles/global.css';
---

<Layout>
  <Nav />
  <main id="main" role="main">
    <Hero />
    <Features />
    <Demo />
    <NotchShowcase />
    <Productivity />
    <Download />
  </main>
  <Footer />
</Layout>

<!-- ═══════════════════════════════════════════════
     GSAP Animations — runs after full page load
     ═══════════════════════════════════════════════ -->
<script>
import gsap from 'gsap';
import { ScrollTrigger } from 'gsap/ScrollTrigger';

gsap.registerPlugin(ScrollTrigger);

/* ── 1. Hero entrance ── */
const heroTl = gsap.timeline({ defaults: { ease: 'power3.out' } });

heroTl
  .from('#h-badge', { y: 18, opacity: 0, duration: 0.6, delay: 0.1 })
  .from('#h-title', { y: 36, opacity: 0, duration: 0.85 }, '-=0.3')
  .from('#h-sub',   { y: 24, opacity: 0, duration: 0.7  }, '-=0.55')
  .from('#h-search',{ y: 18, opacity: 0, scale: 0.97, duration: 0.65 }, '-=0.45')
  .from('#h-ctas  .btn-primary',  { y: 16, opacity: 0, duration: 0.5 }, '-=0.4')
  .from('#h-ctas  .btn-secondary',{ y: 16, opacity: 0, duration: 0.5 }, '-=0.4')
  .from('#h-scroll',{ y: 12, opacity: 0, duration: 0.5 }, '-=0.2')
  .from('#h-window',{ y: 40, opacity: 0, duration: 1.1, ease: 'power4.out' }, 0.5)
  .from('#h-util',  { y: 24, opacity: 0, duration: 0.8, ease: 'power3.out' }, 0.75);

/* ── 2. Typing animation in hero search bar ── */
const QUERIES = [
  'Open Figma',
  '100 USD to EUR',
  '15% of 280',
  'Time in Tokyo',
  'github.com',
  'npm install react',
];

let qIdx = 0;
const searchEl    = document.getElementById('search-text');
const mockQueryEl = document.getElementById('mock-query');

function sleep(ms: number) { return new Promise<void>(r => setTimeout(r, ms)); }

async function typingLoop() {
  while (true) {
    const query = QUERIES[qIdx % QUERIES.length];
    qIdx++;

    // Type
    for (let i = 0; i <= query.length; i++) {
      const slice = query.slice(0, i);
      if (searchEl)    searchEl.textContent    = slice;
      if (mockQueryEl) mockQueryEl.textContent = slice || 'Type to search…';
      await sleep(50 + Math.random() * 40);
    }

    await sleep(2200);

    // Delete
    for (let i = query.length; i >= 0; i--) {
      const slice = query.slice(0, i);
      if (searchEl)    searchEl.textContent    = slice;
      if (mockQueryEl) mockQueryEl.textContent = slice || 'Type to search…';
      await sleep(28);
    }

    await sleep(500);
  }
}

// Start after hero entrance is ~done
setTimeout(typingLoop, 1200);

/* ── 3. ScrollTrigger reveals ── */
const revealEls = gsap.utils.toArray<HTMLElement>('.reveal');
revealEls.forEach(el => {
  // Skip hero elements that are already animated
  if (el.id && el.id.startsWith('h-')) return;

  gsap.from(el, {
    y: 32,
    opacity: 0,
    duration: 0.85,
    ease: 'power3.out',
    scrollTrigger: {
      trigger: el,
      start: 'top 88%',
      once: true,
    },
  });
});

/* ── 4. Feature cards stagger reveal ── */
gsap.from('.feat-card', {
  y: 40,
  opacity: 0,
  duration: 0.75,
  stagger: 0.08,
  ease: 'power3.out',
  scrollTrigger: {
    trigger: '.feat-grid',
    start: 'top 82%',
    once: true,
  },
});

/* ── 5. Stats counter animation ── */
document.querySelectorAll('.stat-val').forEach(el => {
  const text = (el as HTMLElement).textContent ?? '';
  // Only animate numeric values
  const num = parseFloat(text.replace(/[^\d.]/g, ''));
  if (!isNaN(num) && num > 1 && !text.includes('∞') && !text.includes('<')) {
    const obj = { val: 0 };
    ScrollTrigger.create({
      trigger: el,
      start: 'top 85%',
      once: true,
      onEnter: () => {
        gsap.to(obj, {
          val: num,
          duration: 1.4,
          ease: 'power2.out',
          onUpdate() {
            (el as HTMLElement).textContent = Math.round(obj.val).toString();
          },
        });
      },
    });
  }
});

/* ── 6. Parallax on hero background glow ── */
gsap.to('.bg-glow', {
  y: 80,
  ease: 'none',
  scrollTrigger: {
    trigger: '#hero',
    start: 'top top',
    end: 'bottom top',
    scrub: 1,
  },
});

/* ── 7. Pillar items stagger ── */
gsap.from('.pillar', {
  y: 28,
  opacity: 0,
  duration: 0.7,
  stagger: 0.1,
  ease: 'power3.out',
  scrollTrigger: {
    trigger: '.pillars-grid',
    start: 'top 80%',
    once: true,
  },
});

/* ── 8. Command rows stagger ── */
gsap.from('.cmd-row', {
  x: -16,
  opacity: 0,
  duration: 0.55,
  stagger: 0.07,
  ease: 'power2.out',
  scrollTrigger: {
    trigger: '.cmd-preview',
    start: 'top 82%',
    once: true,
  },
});

/* ── 9. Demo steps stagger ── */
gsap.from('.demo-step', {
  y: 24,
  opacity: 0,
  duration: 0.6,
  stagger: 0.12,
  ease: 'power3.out',
  scrollTrigger: {
    trigger: '.demo-steps',
    start: 'top 80%',
    once: true,
  },
});

/* ── 10. Magnetic button effect ── */
document.querySelectorAll<HTMLElement>('.btn-magnetic').forEach(btn => {
  btn.addEventListener('mousemove', (e) => {
    const rect = btn.getBoundingClientRect();
    const x = e.clientX - rect.left - rect.width  / 2;
    const y = e.clientY - rect.top  - rect.height / 2;
    gsap.to(btn, {
      x: x * 0.18,
      y: y * 0.18,
      duration: 0.4,
      ease: 'power2.out',
    });
  });

  btn.addEventListener('mouseleave', () => {
    gsap.to(btn, { x: 0, y: 0, duration: 0.65, ease: 'elastic.out(1, 0.4)' });
  });
});

/* ── 11. Notch showcase — screenshot scale-in + callout stagger ── */
gsap.from('.ns-display', {
  scale: 0.94,
  opacity: 0,
  duration: 1.1,
  ease: 'power3.out',
  scrollTrigger: { trigger: '#notch-showcase', start: 'top 78%', once: true },
});

gsap.from('.ns-callout', {
  y: 24,
  opacity: 0,
  duration: 0.65,
  stagger: 0.12,
  ease: 'power3.out',
  scrollTrigger: { trigger: '.ns-callouts', start: 'top 85%', once: true },
});

/* ── 12. Download section entrance ── */
gsap.from('.dl-icon', {
  scale: 0.7,
  opacity: 0,
  duration: 0.9,
  ease: 'back.out(1.7)',
  scrollTrigger: { trigger: '#download', start: 'top 80%', once: true },
});

gsap.from('.dl-btn', {
  y: 24,
  opacity: 0,
  duration: 0.7,
  stagger: 0.12,
  ease: 'power3.out',
  scrollTrigger: { trigger: '.dl-buttons', start: 'top 85%', once: true },
});
</script>
