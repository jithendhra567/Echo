---
import Layout           from '../layouts/Layout.astro';
import Nav              from '../components/Nav.astro';
import Hero             from '../components/Hero.astro';
import ChapterLauncher  from '../components/ChapterLauncher.astro';
import ChapterClipboard from '../components/ChapterClipboard.astro';
import ChapterNotch     from '../components/ChapterNotch.astro';
import Features         from '../components/Features.astro';
import Download         from '../components/Download.astro';
import Footer           from '../components/Footer.astro';
import '../styles/global.css';
---

<Layout>
  <Nav />
  <main id="main" role="main">
    <Hero />
    <ChapterLauncher />
    <ChapterClipboard />
    <ChapterNotch />
    <Features />
    <Download />
  </main>
  <Footer />
</Layout>

<!-- ═══════════════════════════════════════════════
     Motion system — Lenis smooth scroll + GSAP
     ═══════════════════════════════════════════════ -->
<script>
import gsap from 'gsap';
import { ScrollTrigger } from 'gsap/ScrollTrigger';
import Lenis from 'lenis';

gsap.registerPlugin(ScrollTrigger);

/* ── Lenis smooth scroll, driven by GSAP's ticker ── */
const lenis = new Lenis({
  duration: 1.1,
  easing: (t: number) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
});

lenis.on('scroll', ScrollTrigger.update);
gsap.ticker.add((time) => lenis.raf(time * 1000));
gsap.ticker.lagSmoothing(0);

/* Smooth anchor navigation */
document.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach(a => {
  a.addEventListener('click', (e) => {
    const target = document.querySelector(a.getAttribute('href') ?? '');
    if (target) {
      e.preventDefault();
      lenis.scrollTo(target as HTMLElement, { offset: 0 });
    }
  });
});

/* ── Hero entrance (runs everywhere) ── */
gsap.timeline({ defaults: { ease: 'power3.out' } })
  .from('#hero-badge',  { y: 18, opacity: 0, duration: 0.6, delay: 0.1 })
  .from('#hero-title',  { y: 36, opacity: 0, duration: 0.85 }, '-=0.3')
  .from('#hero-sub',    { y: 24, opacity: 0, duration: 0.7  }, '-=0.55')
  .from('#hero-ctas',   { y: 18, opacity: 0, duration: 0.6  }, '-=0.45')
  .from('#hero-stage',  { y: 60, opacity: 0, duration: 1.1, ease: 'power4.out' }, 0.4)
  .from('#hero-scroll-hint', { opacity: 0, duration: 0.6 }, '-=0.3');

/* ═══════════════════════════════════════════════
   Scroll scenes — desktop + motion-ok only.
   Without them the page is a normal static story.
   ═══════════════════════════════════════════════ */
const mm = gsap.matchMedia();

mm.add('(min-width: 768px) and (prefers-reduced-motion: no-preference)', () => {

  /* ── 1. Hero: video frame straightens as you scroll ── */
  gsap.fromTo('#hero-screen',
    { rotateX: 24, scale: 0.92, y: 20 },
    {
      rotateX: 0, scale: 1, y: 0,
      ease: 'none',
      scrollTrigger: {
        trigger: '#hero',
        start: 'top top',
        end: '+=60%',
        pin: '#hero-sticky',
        pinSpacing: true,
        scrub: 0.6,
        anticipatePin: 1,
      },
    }
  );

  gsap.to('#hero-scroll-hint', {
    opacity: 0,
    scrollTrigger: { trigger: '#hero', start: 'top top', end: '+=15%', scrub: true },
  });

  /* ── 2. Chapters: pin, cycle beats, crossfade media ── */
  const chapters = gsap.utils.toArray<HTMLElement>('[data-chapter]');

  chapters.forEach(section => {
    const beats      = Array.from(section.querySelectorAll<HTMLElement>('[data-beat]'));
    const mediaItems = Array.from(section.querySelectorAll<HTMLElement>('[data-media-item]'));
    const stage      = section.querySelector<HTMLElement>('[data-stage]');
    if (!beats.length) return;

    section.classList.add('fx');

    gsap.set(beats, { autoAlpha: 0, y: 26 });
    gsap.set(beats[0], { autoAlpha: 1, y: 0 });
    mediaItems.forEach((m, i) => gsap.set(m, { autoAlpha: i === 0 ? 1 : 0 }));

    /* 3D approach as the chapter scrolls into view */
    if (stage) {
      gsap.fromTo(stage,
        { rotateX: 16, scale: 0.94, transformPerspective: 1200 },
        {
          rotateX: 0, scale: 1,
          ease: 'none',
          scrollTrigger: {
            trigger: section,
            start: 'top bottom',
            end: 'top top',
            scrub: 0.6,
          },
        }
      );
    }

    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: section,
        start: 'top top',
        end: `+=${beats.length * 70}%`,
        pin: true,
        scrub: 0.6,
        anticipatePin: 1,
      },
    });

    let currentMedia = 0;

    /* hold on the first beat */
    tl.to({}, { duration: 0.6 });

    beats.forEach((beat, i) => {
      if (i === 0) return;
      const prev  = beats[i - 1];
      const label = `beat${i}`;

      tl.addLabel(label)
        .to(prev, { autoAlpha: 0, y: -26, duration: 0.3 }, label)
        .fromTo(beat, { autoAlpha: 0, y: 26 }, { autoAlpha: 1, y: 0, duration: 0.3 }, `${label}+=0.12`);

      const m = parseInt(beat.dataset.media ?? '', 10);
      if (!isNaN(m) && m !== currentMedia && mediaItems[m]) {
        tl.to(mediaItems[currentMedia], { autoAlpha: 0, scale: 0.96, duration: 0.3 }, label)
          .fromTo(mediaItems[m], { autoAlpha: 0, scale: 1.05 }, { autoAlpha: 1, scale: 1, duration: 0.3 }, `${label}+=0.12`);
        currentMedia = m;
      }

      tl.to({}, { duration: 0.6 });
    });
  });

  /* ── 3. Clipboard parallax floats ── */
  gsap.utils.toArray<HTMLElement>('[data-parallax]').forEach(el => {
    const amount = parseFloat(el.dataset.parallax ?? '20');
    gsap.fromTo(el,
      { y: -amount },
      {
        y: amount,
        ease: 'none',
        scrollTrigger: {
          trigger: '#clipboard',
          start: 'top bottom',
          end: 'bottom top',
          scrub: 1,
        },
      }
    );
  });

  /* ── 4. Reveals ── */
  gsap.utils.toArray<HTMLElement>('.reveal').forEach(el => {
    gsap.from(el, {
      y: 32,
      opacity: 0,
      duration: 0.85,
      ease: 'power3.out',
      scrollTrigger: { trigger: el, start: 'top 88%', once: true },
    });
  });

  /* ── 5. Feature cards stagger per group ── */
  gsap.utils.toArray<HTMLElement>('.feat-group').forEach(group => {
    gsap.from(group.querySelectorAll('.feat-card'), {
      y: 36,
      opacity: 0,
      duration: 0.65,
      stagger: 0.07,
      ease: 'power3.out',
      scrollTrigger: { trigger: group, start: 'top 82%', once: true },
    });
  });

  /* cleanup when leaving this media context */
  return () => {
    chapters.forEach(s => s.classList.remove('fx'));
  };
});
</script>
