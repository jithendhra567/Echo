---
const categories = [
  {
    name: 'Launcher',
    color: '#818cf8',
    features: [
      {
        id: 'search',
        title: 'Instant App Search',
        body: 'Find any installed app in milliseconds. Results ranked by how often you actually use them.',
        accent: '#818cf8',
        accentDim: 'rgba(99,102,241,0.12)',
        span: 'col-span-2',
        icon: `<svg width="22" height="22" viewBox="0 0 22 22" fill="none"><circle cx="9.5" cy="9.5" r="6.5" stroke="currentColor" stroke-width="1.8"/><path d="M14.5 14.5 L19 19" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>`,
      },
      {
        id: 'tabs',
        title: 'Browser Tab Search',
        body: 'Search open tabs in Safari, Chrome, and Arc. Closed tabs stay in history forever.',
        accent: '#38bdf8',
        accentDim: 'rgba(56,189,248,0.12)',
        span: 'col-span-1',
        icon: `<svg width="22" height="22" viewBox="0 0 22 22" fill="none"><rect x="2" y="5" width="18" height="14" rx="2" stroke="currentColor" stroke-width="1.8"/><path d="M2 9h18" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>`,
      },
      {
        id: 'instant',
        title: 'Instant Web Search',
        body: 'Type a URL or query — Echo loads it in a built-in panel without leaving the launcher.',
        accent: '#6366f1',
        accentDim: 'rgba(99,102,241,0.12)',
        span: 'col-span-1',
        icon: `<svg width="22" height="22" viewBox="0 0 22 22" fill="none"><circle cx="11" cy="11" r="8" stroke="currentColor" stroke-width="1.8"/><path d="M2 11h18M11 2a13 13 0 010 18M11 2a13 13 0 000 18" stroke="currentColor" stroke-width="1.4" opacity="0.4"/></svg>`,
      },
      {
        id: 'calc',
        title: 'Inline Calculations',
        body: 'Math, percentages, unit conversions, live currency rates, and world time — computed as you type.',
        accent: '#34d399',
        accentDim: 'rgba(52,211,153,0.12)',
        span: 'col-span-2',
        icon: `<svg width="22" height="22" viewBox="0 0 22 22" fill="none"><path d="M4 11h14M11 4v14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/><circle cx="11" cy="11" r="8" stroke="currentColor" stroke-width="1.4" opacity="0.3"/></svg>`,
      },
    ],
  },
  {
    name: 'Clipboard',
    color: '#a78bfa',
    features: [
      {
        id: 'clipboard',
        title: 'Full Clipboard History',
        body: 'Every copy captured automatically — text, images, URLs, and rich content. Search, pin, and drag anywhere.',
        accent: '#a78bfa',
        accentDim: 'rgba(167,139,250,0.12)',
        span: 'col-span-2',
        icon: `<svg width="22" height="22" viewBox="0 0 22 22" fill="none"><rect x="5" y="3" width="12" height="16" rx="2" stroke="currentColor" stroke-width="1.8"/><path d="M8 8h6M8 12h4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/><rect x="8" y="1" width="6" height="4" rx="1" stroke="currentColor" stroke-width="1.5" fill="none"/></svg>`,
      },
      {
        id: 'metadata',
        title: 'Source App Tracking',
        body: 'See which app each clip came from and the window title — so you always know the context.',
        accent: '#c084fc',
        accentDim: 'rgba(192,132,252,0.12)',
        span: 'col-span-1',
        icon: `<svg width="22" height="22" viewBox="0 0 22 22" fill="none"><rect x="3" y="4" width="16" height="12" rx="2" stroke="currentColor" stroke-width="1.8"/><path d="M7 8h8M7 12h5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>`,
      },
      {
        id: 'retention',
        title: 'Smart Retention',
        body: 'Configurable history length (7–365 days). Pinned clips never expire. Pause capture anytime.',
        accent: '#8b5cf6',
        accentDim: 'rgba(139,92,246,0.12)',
        span: 'col-span-1',
        icon: `<svg width="22" height="22" viewBox="0 0 22 22" fill="none"><path d="M11 3v8l4 2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/><circle cx="11" cy="11" r="8" stroke="currentColor" stroke-width="1.8"/></svg>`,
      },
    ],
  },
  {
    name: 'Notch',
    color: '#ec4899',
    features: [
      {
        id: 'music',
        title: 'Now Playing',
        body: 'Album art, track info, and playback controls in your menu bar notch. Works with any audio app.',
        accent: '#ec4899',
        accentDim: 'rgba(236,72,153,0.12)',
        span: 'col-span-1',
        icon: `<svg width="22" height="22" viewBox="0 0 22 22" fill="none"><rect x="3" y="7" width="3" height="8" rx="1.5" fill="currentColor"/><rect x="8" y="3" width="3" height="16" rx="1.5" fill="currentColor" opacity="0.7"/><rect x="13" y="9" width="3" height="6" rx="1.5" fill="currentColor" opacity="0.45"/></svg>`,
      },
      {
        id: 'tray',
        title: 'Drag Tray',
        body: 'Drop files onto the notch pill. Stash them and drag into any app later — no Finder needed.',
        accent: '#f97316',
        accentDim: 'rgba(249,115,22,0.12)',
        span: 'col-span-1',
        icon: `<svg width="22" height="22" viewBox="0 0 22 22" fill="none"><path d="M11 3v10M7 9l4 4 4-4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/><path d="M3 15v2a2 2 0 002 2h12a2 2 0 002-2v-2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>`,
      },
      {
        id: 'clock',
        title: 'Clock & Calendar',
        body: 'Digital clock, month calendar, and contextual greeting — peek without opening Calendar.app.',
        accent: '#fbbf24',
        accentDim: 'rgba(251,191,36,0.12)',
        span: 'col-span-1',
        icon: `<svg width="22" height="22" viewBox="0 0 22 22" fill="none"><circle cx="11" cy="11" r="8" stroke="currentColor" stroke-width="1.8"/><path d="M11 6v5l3 2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>`,
      },
      {
        id: 'mirror',
        title: 'Camera Mirror',
        body: 'One click reveals a live front-camera preview inside the notch — no extra window required.',
        accent: '#f472b6',
        accentDim: 'rgba(244,114,182,0.12)',
        span: 'col-span-1',
        icon: `<svg width="22" height="22" viewBox="0 0 22 22" fill="none"><rect x="3" y="6" width="16" height="12" rx="2" stroke="currentColor" stroke-width="1.8"/><circle cx="11" cy="12" r="3" stroke="currentColor" stroke-width="1.6"/></svg>`,
      },
    ],
  },
  {
    name: 'Privacy & More',
    color: '#34d399',
    features: [
      {
        id: 'privacy',
        title: 'Privacy Controls',
        body: 'Block specific apps and websites from being captured. Skip password-manager copies automatically.',
        accent: '#34d399',
        accentDim: 'rgba(52,211,153,0.12)',
        span: 'col-span-1',
        icon: `<svg width="22" height="22" viewBox="0 0 22 22" fill="none"><path d="M11 3L4 7v5c0 4.5 3 7.5 7 9 4-1.5 7-4.5 7-9V7L11 3z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>`,
      },
      {
        id: 'stats',
        title: 'Usage Statistics',
        body: 'See your most-launched apps, top websites, and clipboard patterns in a built-in dashboard.',
        accent: '#22d3ee',
        accentDim: 'rgba(34,211,238,0.12)',
        span: 'col-span-1',
        icon: `<svg width="22" height="22" viewBox="0 0 22 22" fill="none"><rect x="3" y="12" width="4" height="7" rx="1" fill="currentColor" opacity="0.5"/><rect x="9" y="8" width="4" height="11" rx="1" fill="currentColor" opacity="0.7"/><rect x="15" y="4" width="4" height="15" rx="1" fill="currentColor"/></svg>`,
      },
      {
        id: 'local',
        title: '100% Local',
        body: 'No cloud, no accounts, no subscriptions. Everything stays on your Mac. Currency rates cached offline.',
        accent: '#64748b',
        accentDim: 'rgba(100,116,139,0.12)',
        span: 'col-span-2',
        icon: `<svg width="22" height="22" viewBox="0 0 22 22" fill="none"><rect x="4" y="8" width="14" height="11" rx="2" stroke="currentColor" stroke-width="1.8"/><path d="M7 8V6a4 4 0 018 0v2" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/><circle cx="11" cy="14" r="1.5" fill="currentColor"/></svg>`,
      },
    ],
  },
];

const allFeatures = categories.flatMap(c => c.features);
---

<section id="features" aria-labelledby="features-title">
  <div class="section-wrap">

    <div class="section-head reveal">
      <span class="section-eyebrow">Full feature list</span>
      <h2 id="features-title" class="section-h2">
        {allFeatures.length} features.<br />
        <em class="grad" style="font-style:normal;">One menu bar app.</em>
      </h2>
      <p class="section-sub">
        Everything Echo can do — organized by the three panels you already know.
      </p>
    </div>

    <!-- Category tabs -->
    <div class="feat-categories reveal" role="tablist" aria-label="Feature categories">
      <button class="feat-cat active" data-cat="all" role="tab" aria-selected="true">All</button>
      {categories.map(c => (
        <button class="feat-cat" data-cat={c.name.toLowerCase()} role="tab" aria-selected="false" style={`--cat-color:${c.color};`}>
          {c.name}
        </button>
      ))}
    </div>

    {categories.map(cat => (
      <div class="feat-category" data-category={cat.name.toLowerCase()}>
        <div class="feat-cat-label" style={`color:${cat.color};`}>{cat.name}</div>
        <div class="feat-grid" role="list">
          {cat.features.map(f => (
            <article
              class={`feat-card glass reveal ${f.span}`}
              role="listitem"
              data-cat={cat.name.toLowerCase()}
              style={`--feat-accent:${f.accent}; --feat-dim:${f.accentDim};`}
            >
              <div class="feat-icon" style={`background:${f.accentDim}; color:${f.accent};`}
                   aria-hidden="true" set:html={f.icon} />
              <div class="feat-body">
                <h3 class="feat-title">{f.title}</h3>
                <p class="feat-desc">{f.body}</p>
              </div>

              {f.id === 'calc' && (
                <div class="feat-calc-demo" aria-hidden="true">
                  <div class="calc-row"><span class="calc-q">15% of 280</span><span class="calc-a" style={`color:${f.accent};`}>42</span></div>
                  <div class="calc-row"><span class="calc-q">100 kg to lb</span><span class="calc-a" style={`color:${f.accent};`}>220.46 lb</span></div>
                  <div class="calc-row"><span class="calc-q">time in Tokyo</span><span class="calc-a" style={`color:${f.accent};`}>09:41 JST</span></div>
                </div>
              )}

              {f.id === 'clipboard' && (
                <div class="feat-clip-demo" aria-hidden="true">
                  <div class="clip-item selected-clip">
                    <div class="clip-icon">T</div>
                    <div class="clip-text">npm install tailwindcss gsap</div>
                    <div class="clip-source">Terminal</div>
                  </div>
                  <div class="clip-item">
                    <div class="clip-icon" style="background:rgba(56,189,248,0.2);color:#38bdf8;">🔗</div>
                    <div class="clip-text" style="color:#71717a;">https://figma.com/file/...</div>
                    <div class="clip-source">Chrome</div>
                  </div>
                </div>
              )}

              <div class="feat-glow" aria-hidden="true"
                   style={`background: radial-gradient(circle at 0% 100%, ${f.accentDim} 0%, transparent 70%);`}>
              </div>
            </article>
          ))}
        </div>
      </div>
    ))}

  </div>
</section>

<style>
  #features {
    padding: 120px 0;
    position: relative;
  }

  #features::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 70% 40% at 50% 0%, rgba(139,92,246,0.06), transparent);
    pointer-events: none;
  }

  .section-wrap {
    max-width: 1160px;
    margin: 0 auto;
    padding: 0 24px;
    position: relative;
  }

  .section-head {
    text-align: center;
    margin-bottom: 48px;
  }

  .section-eyebrow {
    display: inline-block;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 16px;
  }

  .section-h2 {
    font-size: clamp(36px, 5vw, 60px);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1.08;
    color: #fafafa;
    margin: 0 0 16px;
  }

  .section-sub {
    font-size: 17px;
    color: #71717a;
    line-height: 1.6;
    max-width: 460px;
    margin: 0 auto;
  }

  /* Category filter tabs */
  .feat-categories {
    display: flex;
    gap: 8px;
    justify-content: center;
    flex-wrap: wrap;
    margin-bottom: 48px;
  }

  .feat-cat {
    padding: 8px 18px;
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 100px;
    font-size: 13px;
    font-weight: 600;
    color: #71717a;
    cursor: pointer;
    transition: all 0.25s;
    font-family: var(--font);
  }

  .feat-cat:hover {
    color: #fafafa;
    border-color: rgba(255,255,255,0.14);
  }

  .feat-cat.active {
    background: color-mix(in srgb, var(--cat-color, var(--accent)) 12%, transparent);
    border-color: color-mix(in srgb, var(--cat-color, var(--accent)) 30%, transparent);
    color: var(--cat-color, #c4b5fd);
  }

  .feat-cat[data-cat="all"].active {
    background: rgba(167,139,250,0.12);
    border-color: rgba(167,139,250,0.3);
    color: #c4b5fd;
  }

  /* Category sections */
  .feat-category {
    margin-bottom: 48px;
    transition: opacity 0.3s;
  }

  .feat-category.hidden { display: none; }

  .feat-cat-label {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-bottom: 16px;
    opacity: 0.7;
  }

  .feat-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
  }

  .col-span-1 { grid-column: span 1; }
  .col-span-2 { grid-column: span 2; }

  .feat-card {
    position: relative;
    overflow: hidden;
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    min-height: 160px;
  }

  .feat-icon {
    width: 42px;
    height: 42px;
    border-radius: 11px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .feat-body { flex: 1; }

  .feat-title {
    font-size: 15px;
    font-weight: 700;
    color: #fafafa;
    letter-spacing: -0.02em;
    margin: 0 0 6px;
    line-height: 1.3;
  }

  .feat-desc {
    font-size: 13.5px;
    line-height: 1.6;
    color: #71717a;
    margin: 0;
  }

  .feat-glow {
    position: absolute;
    inset: 0;
    pointer-events: none;
    border-radius: inherit;
  }

  .feat-calc-demo {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 12px;
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(255,255,255,0.06);
    border-radius: 10px;
  }

  .calc-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 12px;
  }

  .calc-q { color: #52525b; font-family: 'SF Mono', 'Fira Code', monospace; }
  .calc-a { font-weight: 700; font-size: 12.5px; }

  .feat-clip-demo {
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  .clip-item {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 7px 9px;
    background: rgba(255,255,255,0.02);
    border: 1px solid rgba(255,255,255,0.05);
    border-radius: 7px;
  }

  .selected-clip {
    background: rgba(167,139,250,0.08);
    border-color: rgba(167,139,250,0.2);
  }

  .clip-icon {
    width: 24px;
    height: 24px;
    border-radius: 5px;
    background: rgba(167,139,250,0.2);
    color: #a78bfa;
    font-size: 11px;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .clip-text {
    font-size: 10.5px;
    color: #fafafa;
    font-family: 'SF Mono', 'Fira Code', monospace;
    flex: 1;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .clip-source { font-size: 9.5px; color: #3f3f46; flex-shrink: 0; }

  @media (max-width: 768px) {
    .feat-grid { grid-template-columns: 1fr; }
    .col-span-2 { grid-column: span 1; }
  }

  @media (min-width: 769px) and (max-width: 1024px) {
    .feat-grid { grid-template-columns: repeat(2, 1fr); }
    .col-span-2 { grid-column: span 2; }
  }
</style>

<script>
  const catBtns  = document.querySelectorAll<HTMLButtonElement>('.feat-cat');
  const sections = document.querySelectorAll<HTMLElement>('.feat-category');

  catBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const cat = btn.dataset.cat ?? 'all';

      catBtns.forEach(b => {
        b.classList.toggle('active', b === btn);
        b.setAttribute('aria-selected', String(b === btn));
      });

      sections.forEach(sec => {
        if (cat === 'all') {
          sec.classList.remove('hidden');
        } else {
          sec.classList.toggle('hidden', sec.dataset.category !== cat);
        }
      });
    });
  });
</script>
