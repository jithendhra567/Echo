---
const steps = [
  {
    id: 'launcher',
    tag: '01',
    title: 'Command your workspace',
    body: 'One keystroke opens the launcher. Type to find apps, browser tabs, bookmarks, or run a web search — all in one place, ranked by how you work.',
    detail: 'Default hotkey: ⌘Space',
  },
  {
    id: 'clipboard',
    tag: '02',
    title: 'Your clipboard, organized',
    body: 'Every copy is captured automatically. Text, images, URLs, rich content — search your entire history, then drag or paste it anywhere.',
    detail: 'Default hotkey: ⌘⇧V',
  },
  {
    id: 'tray',
    tag: '03',
    title: 'Drop anything. Use it anywhere.',
    body: 'Drag a file onto the notch pill and it stashes in the Tray. Grab it again later and drop it into any app, no Finder needed.',
    detail: 'Drag onto the notch to activate',
  },
];
---

<section id="demo" aria-labelledby="demo-title">
  <div class="demo-outer">

    <!-- Sticky header label -->
    <div class="demo-label-wrap reveal">
      <span class="section-eyebrow">How it works</span>
      <h2 id="demo-title" class="section-h2">
        Three panels.<br />
        <em class="grad" style="font-style:normal;">Zero friction.</em>
      </h2>
    </div>

    <!-- Sticky scroll layout -->
    <div class="demo-layout">

      <!-- Left: scrollable steps -->
      <div class="demo-steps" role="list">
        {steps.map((s, i) => (
          <div
            class={`demo-step${i === 0 ? ' active' : ''}`}
            data-step={i}
            role="listitem"
            aria-label={s.title}
          >
            <span class="step-tag">{s.tag}</span>
            <h3 class="step-title">{s.title}</h3>
            <p  class="step-body">{s.body}</p>
            <span class="step-detail">{s.detail}</span>
          </div>
        ))}
      </div>

      <!-- Right: sticky display -->
      <div class="demo-display">
        <div class="demo-screen mac-window" id="demo-window">

          <!-- Window chrome -->
          <div class="mac-titlebar">
            <span class="mac-dot" style="background:#ff5f57;"></span>
            <span class="mac-dot" style="background:#febc2e;"></span>
            <span class="mac-dot" style="background:#28c840;"></span>
            <span class="demo-window-title" id="demo-win-label">Launcher</span>
          </div>

          <!-- Panel 0: Launcher -->
          <div class="demo-panel" data-panel="0">
            <div class="mock-search-row">
              <span class="mock-cmd-key">⌘</span>
              <span class="demo-typing" id="demo-type-0">figma</span>
              <span class="cursor" style="height:14px;"></span>
            </div>
            <div class="mock-section-label">APPLICATIONS</div>
            <div class="mock-result selected"><div class="mock-icon fig">🎨</div><span class="mock-name">Figma</span><span class="mock-ret">↵</span></div>
            <div class="mock-result"><div class="mock-icon vsc">💻</div><span class="mock-name">VS Code</span></div>
            <div class="mock-result"><div class="mock-icon arc">🌐</div><span class="mock-name">Arc</span></div>
            <div class="mock-section-label" style="margin-top:4px;">BROWSER TABS</div>
            <div class="mock-result"><div class="mock-icon fgm">🔖</div><span class="mock-name tab">Design System – Figma</span></div>
            <div class="mock-result last"><div class="mock-icon lin">🔖</div><span class="mock-name tab">figma.com/file/XK2...</span></div>
          </div>

          <!-- Panel 1: Clipboard -->
          <div class="demo-panel hidden" data-panel="1">
            <div class="mock-search-row">
              <span class="mock-cmd-key">⌘</span>
              <span class="demo-typing">Search clipboard...</span>
            </div>
            <div class="mock-section-label">CLIPBOARD HISTORY</div>
            <div class="clip-demo-row selected">
              <div class="clip-demo-icon code">T</div>
              <div class="clip-demo-body">
                <div class="clip-demo-text"><code>npm install tailwindcss gsap</code></div>
                <div class="clip-demo-meta">Terminal · just now</div>
              </div>
            </div>
            <div class="clip-demo-row">
              <div class="clip-demo-icon url">🔗</div>
              <div class="clip-demo-body">
                <div class="clip-demo-text url-text">https://github.com/owner/repo</div>
                <div class="clip-demo-meta">Chrome · 2 min ago</div>
              </div>
            </div>
            <div class="clip-demo-row">
              <div class="clip-demo-icon txt">T</div>
              <div class="clip-demo-body">
                <div class="clip-demo-text">Meeting notes from Monday standup</div>
                <div class="clip-demo-meta">Notes · 8 min ago</div>
              </div>
            </div>
            <div class="clip-demo-row">
              <div class="clip-demo-icon img">🖼</div>
              <div class="clip-demo-body">
                <div class="clip-demo-text">screenshot.png <span class="clip-badge">Image</span></div>
                <div class="clip-demo-meta">Screenshot · 12 min ago</div>
              </div>
            </div>
          </div>

          <!-- Panel 2: Tray -->
          <div class="demo-panel hidden" data-panel="2">
            <div class="tray-demo-header">
              <span class="tray-demo-label">TRAY</span>
              <div class="tray-seg">
                <button class="seg active">Copy</button>
                <button class="seg">Move</button>
              </div>
            </div>
            <div class="tray-drop-area">
              <div class="tray-file-grid">
                <div class="tray-file-card">
                  <div class="tfc-preview" style="background:linear-gradient(135deg,#3b82f6,#8b5cf6);">PDF</div>
                  <div class="tfc-name">Report_Q4.pdf</div>
                </div>
                <div class="tray-file-card selected-card">
                  <div class="tfc-preview" style="background:linear-gradient(135deg,#ec4899,#f97316);">PNG</div>
                  <div class="tfc-name">hero-image.png</div>
                  <div class="tfc-check">✓</div>
                </div>
                <div class="tray-file-card">
                  <div class="tfc-preview" style="background:linear-gradient(135deg,#34d399,#38bdf8);">ZIP</div>
                  <div class="tfc-name">assets.zip</div>
                </div>
                <div class="tray-add">
                  <div class="tray-add-inner">+</div>
                </div>
              </div>
              <div class="drop-hint">Drop files here or drag from Finder</div>
            </div>
          </div>
        </div>

        <!-- Step progress dots -->
        <div class="demo-dots" role="tablist" aria-label="Demo steps">
          {steps.map((s, i) => (
            <button
              class={`progress-dot${i === 0 ? ' active' : ''}`}
              role="tab"
              aria-selected={i === 0 ? 'true' : 'false'}
              aria-label={s.title}
              data-dot={i}
            />
          ))}
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  #demo {
    padding: 120px 0;
    position: relative;
  }

  #demo::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 70% 50% at 50% 50%, rgba(139,92,246,0.06), transparent);
    pointer-events: none;
  }

  .demo-outer {
    max-width: 1160px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .demo-label-wrap {
    text-align: center;
    margin-bottom: 72px;
  }

  .section-eyebrow {
    display: inline-block;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 16px;
  }

  .section-h2 {
    font-size: clamp(36px, 5vw, 60px);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1.08;
    color: #fafafa;
    margin: 0;
  }

  /* Layout */
  .demo-layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: start;
  }

  /* Steps (left) */
  .demo-steps {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .demo-step {
    padding: 32px 0;
    border-bottom: 1px solid rgba(255,255,255,0.05);
    opacity: 0.35;
    transition: opacity 0.4s ease;
    cursor: pointer;
  }

  .demo-step:first-child { padding-top: 0; }
  .demo-step:last-child  { border-bottom: none; }
  .demo-step.active      { opacity: 1; }

  .step-tag {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--accent);
    opacity: 0.7;
    display: block;
    margin-bottom: 12px;
  }

  .step-title {
    font-size: clamp(20px, 2.5vw, 26px);
    font-weight: 700;
    color: #fafafa;
    letter-spacing: -0.025em;
    line-height: 1.2;
    margin: 0 0 12px;
  }

  .step-body {
    font-size: 15px;
    color: #71717a;
    line-height: 1.65;
    margin: 0 0 14px;
  }

  .step-detail {
    font-size: 12px;
    color: #3f3f46;
    font-family: 'SF Mono', 'Fira Code', monospace;
    font-weight: 500;
  }

  /* Display (right) */
  .demo-display {
    position: sticky;
    top: 100px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
  }

  .demo-screen {
    width: 100%;
    max-width: 440px;
    min-height: 340px;
  }

  /* Panel content */
  .demo-panel { padding-bottom: 8px; }
  .demo-panel.hidden { display: none; }

  .demo-window-title {
    flex: 1;
    text-align: center;
    font-size: 12px;
    font-weight: 600;
    color: #52525b;
    letter-spacing: 0.01em;
    margin-right: 52px;
  }

  /* Shared mock styles */
  .mock-search-row {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 13px 14px;
    border-bottom: 1px solid rgba(255,255,255,0.06);
    background: rgba(255,255,255,0.02);
  }

  .mock-cmd-key {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    background: rgba(255,255,255,0.07);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 5px;
    font-size: 12px;
    color: #71717a;
    flex-shrink: 0;
  }

  .demo-typing {
    font-size: 13px;
    font-weight: 500;
    color: #fafafa;
    flex: 1;
  }

  .mock-section-label {
    font-size: 9.5px;
    font-weight: 700;
    color: #3f3f46;
    letter-spacing: 0.1em;
    padding: 10px 14px 4px;
  }

  .mock-result {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 7px 14px;
  }

  .mock-result.selected {
    background: rgba(139,92,246,0.14);
    border-left: 2px solid #a78bfa;
  }

  .mock-result.last { margin-bottom: 4px; }

  .mock-icon {
    width: 28px;
    height: 28px;
    border-radius: 7px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 15px;
    background: rgba(255,255,255,0.07);
    flex-shrink: 0;
  }

  .mock-name { font-size: 13px; font-weight: 500; color: #fafafa; flex: 1; }
  .mock-name.tab { color: #71717a; font-size: 11.5px; }
  .mock-ret  { font-size: 12px; color: #a78bfa; font-weight: 600; }

  /* Clipboard panel */
  .clip-demo-row {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    padding: 10px 14px;
    border-bottom: 1px solid rgba(255,255,255,0.04);
    transition: background 0.15s;
  }

  .clip-demo-row.selected { background: rgba(167,139,250,0.08); }

  .clip-demo-icon {
    width: 30px;
    height: 30px;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 13px;
    font-weight: 700;
    flex-shrink: 0;
    background: rgba(167,139,250,0.2);
    color: #a78bfa;
  }

  .clip-demo-icon.url { background: rgba(56,189,248,0.15); color: #38bdf8; font-size: 16px; }
  .clip-demo-icon.txt { background: rgba(52,211,153,0.15); color: #34d399; }
  .clip-demo-icon.img { background: rgba(251,191,36,0.15); color: #fbbf24; font-size: 16px; }

  .clip-demo-body { flex: 1; min-width: 0; }

  .clip-demo-text {
    font-size: 12px;
    color: #d4d4d8;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    margin-bottom: 3px;
    font-family: 'SF Mono', 'Fira Code', monospace;
  }

  .clip-demo-text.url-text { color: #38bdf8; }

  .clip-demo-meta { font-size: 10px; color: #52525b; }

  .clip-badge {
    display: inline-block;
    padding: 1px 7px;
    background: rgba(251,191,36,0.15);
    border: 1px solid rgba(251,191,36,0.25);
    border-radius: 4px;
    color: #fbbf24;
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 0.05em;
    font-family: var(--font);
    vertical-align: middle;
    margin-left: 6px;
  }

  /* Tray panel */
  .tray-demo-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 14px 8px;
    border-bottom: 1px solid rgba(255,255,255,0.06);
  }

  .tray-demo-label {
    font-size: 9.5px;
    font-weight: 700;
    color: #3f3f46;
    letter-spacing: 0.1em;
  }

  .tray-seg {
    display: flex;
    background: rgba(255,255,255,0.06);
    border-radius: 6px;
    padding: 2px;
    gap: 2px;
  }

  .seg {
    padding: 3px 10px;
    font-size: 11px;
    font-weight: 600;
    color: #52525b;
    background: none;
    border: none;
    border-radius: 4px;
    cursor: pointer;
    transition: all 0.15s;
  }

  .seg.active {
    background: rgba(167,139,250,0.18);
    color: #a78bfa;
  }

  .tray-drop-area {
    padding: 14px;
  }

  .tray-file-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 10px;
    margin-bottom: 12px;
  }

  .tray-file-card {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
  }

  .tfc-preview {
    width: 52px;
    height: 60px;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 10px;
    font-weight: 800;
    color: rgba(255,255,255,0.9);
    letter-spacing: 0.05em;
    border: 1px solid rgba(255,255,255,0.12);
  }

  .tfc-name {
    font-size: 9px;
    color: #52525b;
    text-align: center;
    max-width: 56px;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .tfc-check {
    position: absolute;
    top: -4px;
    left: -4px;
    width: 18px;
    height: 18px;
    background: #a78bfa;
    border-radius: 50%;
    border: 1.5px solid #09090b;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 10px;
    color: #09090b;
    font-weight: 800;
  }

  .selected-card .tfc-preview {
    outline: 2px solid #a78bfa;
    outline-offset: 2px;
  }

  .tray-add {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .tray-add-inner {
    width: 52px;
    height: 60px;
    border-radius: 8px;
    border: 1.5px dashed rgba(255,255,255,0.15);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 22px;
    color: #3f3f46;
    font-weight: 300;
  }

  .drop-hint {
    text-align: center;
    font-size: 10.5px;
    color: #3f3f46;
    padding: 6px 0 4px;
  }

  /* Dots */
  .demo-dots {
    display: flex;
    gap: 8px;
    align-items: center;
  }

  /* Responsive */
  @media (max-width: 860px) {
    .demo-layout {
      grid-template-columns: 1fr;
      gap: 48px;
    }

    .demo-display {
      position: static;
      order: -1;
    }
  }
</style>

<script>
  // Demo step switching
  const steps    = Array.from(document.querySelectorAll('.demo-step')) as HTMLElement[];
  const panels   = Array.from(document.querySelectorAll('.demo-panel')) as HTMLElement[];
  const dots     = Array.from(document.querySelectorAll('.progress-dot')) as HTMLButtonElement[];
  const winLabel = document.getElementById('demo-win-label');

  const labels = ['Launcher', 'Clipboard', 'Tray'];

  function activateStep(i: number) {
    steps.forEach((s, idx)  => s.classList.toggle('active', idx === i));
    panels.forEach((p, idx) => p.classList.toggle('hidden', idx !== i));
    dots.forEach((d, idx)   => {
      d.classList.toggle('active', idx === i);
      d.setAttribute('aria-selected', String(idx === i));
    });
    if (winLabel) winLabel.textContent = labels[i] ?? '';
  }

  // Click on step
  steps.forEach((s, i) => s.addEventListener('click', () => activateStep(i)));

  // Click on dot
  dots.forEach((d, i) => d.addEventListener('click', () => activateStep(i)));

  // IntersectionObserver: activate step when it enters viewport center
  if ('IntersectionObserver' in window) {
    const obs = new IntersectionObserver(
      (entries) => {
        entries.forEach(e => {
          if (e.isIntersecting) {
            const idx = parseInt((e.target as HTMLElement).dataset.step ?? '0', 10);
            activateStep(idx);
          }
        });
      },
      { threshold: 0.55 }
    );
    steps.forEach(s => obs.observe(s));
  }
</script>
