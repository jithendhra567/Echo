---
const callouts = [
  {
    id:     'calendar',
    number: '01',
    title:  'Month calendar',
    body:   'At a glance: the full month grid with today highlighted. Never open Calendar.app just to check a date.',
    hx: '17%',   /* hotspot center x as % of image width  */
    hy: '50%',   /* hotspot center y as % of image height */
    hw: '31%',   /* hotspot width  */
    hh: '82%',   /* hotspot height */
  },
  {
    id:     'clock',
    number: '02',
    title:  'Time & greeting',
    body:   'Large digital clock with a contextual greeting. Peek at the time without moving your eyes from your work.',
    hx: '49%',
    hy: '50%',
    hw: '28%',
    hh: '82%',
  },
  {
    id:     'mirror',
    number: '03',
    title:  'Camera mirror',
    body:   'One click reveals a live front-camera preview inside the notch — no extra window, no app to open.',
    hx: '80%',
    hy: '50%',
    hw: '22%',
    hh: '70%',
  },
];
---

<section id="notch-showcase" aria-labelledby="notch-title">
  <div class="ns-wrap">

    <!-- Heading -->
    <div class="ns-head reveal">
      <span class="section-eyebrow">Notch Panel</span>
      <h2 id="notch-title" class="section-h2">
        Your menu bar,<br />
        <em class="grad" style="font-style:normal;">reimagined.</em>
      </h2>
      <p class="section-sub">
        Hover the notch to reveal a rich panel with a live calendar, clock,
        and optional camera mirror — all without stealing focus from your work.
      </p>
    </div>

    <!-- Screenshot frame -->
    <div class="ns-frame-wrap reveal">

      <!-- Notch pill hint at top -->
      <div class="ns-notch-hint" aria-hidden="true">
        <div class="ns-notch-shape notch-pill">
          <div style="display:flex;align-items:center;gap:7px;padding:6px 14px;">
            <div style="width:6px;height:6px;border-radius:50%;background:#a78bfa;box-shadow:0 0 8px rgba(167,139,250,0.8);"></div>
            <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
              <rect x="1" y="3" width="2.5" height="6" rx="1.25" fill="#a78bfa"/>
              <rect x="4.75" y="1" width="2.5" height="10" rx="1.25" fill="#a78bfa" opacity="0.65"/>
              <rect x="8.5" y="4" width="2" height="5" rx="1" fill="#a78bfa" opacity="0.35"/>
            </svg>
            <span style="font-size:11px;color:#71717a;font-weight:500;white-space:nowrap;">EchoBar Notch</span>
          </div>
        </div>
      </div>

      <!-- The mac display frame -->
      <div class="ns-display" role="img" aria-label="EchoBar notch panel showing calendar, clock, and camera mirror">

        <!-- Callout hotspots (invisible interaction areas) -->
        {callouts.map(c => (
          <button
            class="ns-hotspot"
            data-callout={c.id}
            aria-label={`Highlight ${c.title}`}
            style={`left:calc(${c.hx} - ${c.hw}/2); top:calc(${c.hy} - ${c.hh}/2); width:${c.hw}; height:${c.hh};`}
          />
        ))}

        <!-- Highlight overlay -->
        <div class="ns-highlight" id="ns-highlight" aria-hidden="true"></div>

        <!-- The actual screenshot -->
        <img
          src="/screenshots/notch-clock.png"
          alt="EchoBar notch panel expanded to show a May 2026 calendar on the left, a digital clock reading 13:05:56 with 'Good afternoon' greeting in the center, and a camera mirror button on the right"
          class="ns-screenshot"
          width="844"
          height="416"
          loading="lazy"
          decoding="async"
        />
      </div>

      <!-- Ambient glow below screenshot -->
      <div class="ns-ambient" aria-hidden="true"></div>
    </div>

    <!-- Callout cards -->
    <div class="ns-callouts" role="list">
      {callouts.map(c => (
        <div
          class="ns-callout reveal"
          data-callout={c.id}
          role="listitem"
          tabindex="0"
          aria-label={c.title}
        >
          <span class="callout-num">{c.number}</span>
          <div class="callout-body">
            <h3 class="callout-title">{c.title}</h3>
            <p  class="callout-text">{c.body}</p>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>

<style>
  #notch-showcase {
    padding: 120px 0 100px;
    position: relative;
    overflow: hidden;
  }

  #notch-showcase::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 80% 60% at 50% 30%, rgba(139,92,246,0.07), transparent 65%);
    pointer-events: none;
  }

  .ns-wrap {
    max-width: 1060px;
    margin: 0 auto;
    padding: 0 24px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  /* Heading */
  .ns-head {
    text-align: center;
    margin-bottom: 64px;
    max-width: 640px;
  }

  .section-eyebrow {
    display: inline-block;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 16px;
  }

  .section-h2 {
    font-size: clamp(36px, 5vw, 60px);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1.08;
    color: #fafafa;
    margin: 0 0 16px;
  }

  .section-sub {
    font-size: 17px;
    color: #71717a;
    line-height: 1.6;
    margin: 0;
  }

  /* Screenshot frame wrapper */
  .ns-frame-wrap {
    position: relative;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-bottom: 48px;
  }

  /* Notch pill hint at top */
  .ns-notch-hint {
    display: flex;
    justify-content: center;
    margin-bottom: -1px;
    position: relative;
    z-index: 2;
  }

  .ns-notch-shape {
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
    border-bottom: none;
  }

  /* Display frame */
  .ns-display {
    position: relative;
    width: 100%;
    max-width: 820px;
    border-radius: 20px;
    overflow: hidden;
    background: #111115;
    border: 1px solid rgba(255,255,255,0.10);
    box-shadow:
      0 48px 120px rgba(0,0,0,0.6),
      0 0 0 0.5px rgba(255,255,255,0.04),
      inset 0 1px 0 rgba(255,255,255,0.07);
    /* Top corners connect to notch pill */
    border-top-left-radius:  4px;
    border-top-right-radius: 4px;
  }

  /* Hotspot buttons — invisible, hover triggers highlight */
  .ns-hotspot {
    position: absolute;
    background: transparent;
    border: none;
    border-radius: 12px;
    cursor: crosshair;
    z-index: 4;
    transition: box-shadow 0.25s;
  }

  .ns-hotspot:hover,
  .ns-hotspot:focus-visible {
    box-shadow: inset 0 0 0 2px rgba(167,139,250,0.5);
    outline: none;
  }

  /* Highlight overlay */
  .ns-highlight {
    position: absolute;
    background: rgba(167,139,250,0.12);
    border: 1.5px solid rgba(167,139,250,0.45);
    border-radius: 12px;
    pointer-events: none;
    z-index: 3;
    opacity: 0;
    transition: opacity 0.25s ease, left 0.3s ease, top 0.3s ease, width 0.3s ease, height 0.3s ease;
    box-shadow: 0 0 24px rgba(139,92,246,0.2);
  }

  /* Screenshot */
  .ns-screenshot {
    display: block;
    width: 100%;
    height: auto;
    user-select: none;
    -webkit-user-drag: none;
  }

  /* Ambient glow reflection */
  .ns-ambient {
    width: 70%;
    height: 60px;
    background: radial-gradient(ellipse at center, rgba(139,92,246,0.18), transparent 70%);
    filter: blur(24px);
    margin-top: -10px;
    pointer-events: none;
  }

  /* Callout cards */
  .ns-callouts {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    width: 100%;
    max-width: 820px;
  }

  .ns-callout {
    display: flex;
    gap: 14px;
    align-items: flex-start;
    padding: 20px;
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(255,255,255,0.06);
    border-radius: 14px;
    cursor: pointer;
    transition: background 0.25s, border-color 0.25s, transform 0.25s;
    text-align: left;
  }

  .ns-callout:hover,
  .ns-callout:focus-visible {
    background: rgba(167,139,250,0.06);
    border-color: rgba(167,139,250,0.2);
    transform: translateY(-2px);
    outline: none;
  }

  .ns-callout.ns-active {
    background: rgba(167,139,250,0.08);
    border-color: rgba(167,139,250,0.25);
  }

  .callout-num {
    font-size: 11px;
    font-weight: 800;
    color: #a78bfa;
    letter-spacing: 0.05em;
    line-height: 1;
    padding-top: 2px;
    flex-shrink: 0;
    font-variant-numeric: tabular-nums;
  }

  .callout-title {
    font-size: 14px;
    font-weight: 700;
    color: #fafafa;
    letter-spacing: -0.015em;
    margin: 0 0 6px;
    line-height: 1.3;
  }

  .callout-text {
    font-size: 13px;
    color: #71717a;
    line-height: 1.6;
    margin: 0;
  }

  /* Responsive */
  @media (max-width: 640px) {
    .ns-callouts { grid-template-columns: 1fr; }
    .ns-hotspot  { display: none; }
    .ns-highlight{ display: none; }
  }
</style>

<script>
  const hotspots  = document.querySelectorAll<HTMLElement>('.ns-hotspot');
  const callouts  = document.querySelectorAll<HTMLElement>('.ns-callout');
  const highlight = document.getElementById('ns-highlight') as HTMLElement | null;
  const display   = document.querySelector('.ns-display') as HTMLElement | null;

  /* Hotspot definitions (mirrors Astro frontmatter values) */
  const hotspotData: Record<string, { hx: number; hy: number; hw: number; hh: number }> = {
    calendar: { hx: 0.17, hy: 0.50, hw: 0.31, hh: 0.82 },
    clock:    { hx: 0.49, hy: 0.50, hw: 0.28, hh: 0.82 },
    mirror:   { hx: 0.80, hy: 0.50, hw: 0.22, hh: 0.70 },
  };

  function activateCallout(id: string | null) {
    // Update callout cards
    callouts.forEach(c => {
      const isActive = c.dataset.callout === id;
      c.classList.toggle('ns-active', isActive);
    });

    // Update highlight overlay
    if (!highlight || !display || !id) {
      if (highlight) highlight.style.opacity = '0';
      return;
    }

    const data = hotspotData[id];
    if (!data) { highlight.style.opacity = '0'; return; }

    const dw = display.offsetWidth;
    const dh = display.offsetHeight;

    const w = data.hw * dw;
    const h = data.hh * dh;
    const l = data.hx * dw - w / 2;
    const t = data.hy * dh - h / 2;

    highlight.style.left    = `${l}px`;
    highlight.style.top     = `${t}px`;
    highlight.style.width   = `${w}px`;
    highlight.style.height  = `${h}px`;
    highlight.style.opacity = '1';
  }

  // Hotspot hover / focus
  hotspots.forEach(hs => {
    const id = hs.dataset.callout ?? null;
    hs.addEventListener('mouseenter',   () => activateCallout(id));
    hs.addEventListener('focus',        () => activateCallout(id));
    hs.addEventListener('mouseleave',   () => activateCallout(null));
    hs.addEventListener('blur',         () => activateCallout(null));
  });

  // Callout card hover / focus
  callouts.forEach(card => {
    const id = card.dataset.callout ?? null;
    card.addEventListener('mouseenter',   () => activateCallout(id));
    card.addEventListener('focus',        () => activateCallout(id));
    card.addEventListener('mouseleave',   () => activateCallout(null));
    card.addEventListener('blur',         () => activateCallout(null));
  });

  // Recompute hotspot positions on resize
  window.addEventListener('resize', () => {
    // Reset highlight without animation
    if (highlight) highlight.style.opacity = '0';
  }, { passive: true });
</script>
