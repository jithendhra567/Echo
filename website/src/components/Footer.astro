---
const year = new Date().getFullYear();
---

<footer role="contentinfo">
  <div class="ft-top-line" aria-hidden="true"></div>

  <div class="ft-wrap">
    <div class="ft-brand">
      <a href="/" class="ft-logo" aria-label="Echo home">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M4 12 A10 10 0 0 1 20 12" stroke="#a78bfa" stroke-width="2" stroke-linecap="round" opacity="0.3"/>
          <path d="M7 12 A7  7  0 0 1 17 12" stroke="#a78bfa" stroke-width="2" stroke-linecap="round" opacity="0.6"/>
          <path d="M10 12 A4  4  0 0 1 14 12" stroke="#a78bfa" stroke-width="2" stroke-linecap="round"/>
        </svg>
        Echo
      </a>
      <p class="ft-tagline">Clipboard. Launcher. Notch.<br />One keystroke.</p>
    </div>

    <nav class="ft-nav" aria-label="Footer navigation">
      <div class="ft-col">
        <span class="ft-col-title">Product</span>
        <ul role="list">
          <li><a href="#launcher">Launcher</a></li>
          <li><a href="#clipboard">Clipboard</a></li>
          <li><a href="#notch">Notch</a></li>
          <li><a href="#features">Features</a></li>
          <li><a href="#download">Download</a></li>
        </ul>
      </div>

      <div class="ft-col">
        <span class="ft-col-title">Resources</span>
        <ul role="list">
          <li><a href="#">Release notes</a></li>
          <li><a href="#">Feedback</a></li>
        </ul>
      </div>

      <div class="ft-col">
        <span class="ft-col-title">Legal</span>
        <ul role="list">
          <li><a href="#">Privacy policy</a></li>
          <li><a href="#">Terms of use</a></li>
        </ul>
      </div>
    </nav>
  </div>

  <div class="ft-bottom">
    <p class="ft-copy">© {year} Echo. Made for Mac.</p>
    <p class="ft-made">Built with Swift &amp; love.</p>
  </div>
</footer>

<style>
  footer {
    position: relative;
    padding: 80px 24px 40px;
    border-top: 1px solid rgba(255,255,255,0.06);
  }

  .ft-top-line {
    position: absolute;
    top: -1px;
    left: 50%;
    transform: translateX(-50%);
    width: 400px;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(167,139,250,0.3), transparent);
  }

  .ft-wrap {
    max-width: 1100px;
    margin: 0 auto 60px;
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 80px;
  }

  .ft-brand {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .ft-logo {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    color: var(--text-1);
    font-size: 15px;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .ft-tagline {
    font-size: 13px;
    color: var(--text-3);
    margin: 0;
    line-height: 1.6;
  }

  .ft-nav {
    display: flex;
    gap: 64px;
  }

  .ft-col { display: flex; flex-direction: column; gap: 16px; }

  .ft-col-title {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-3);
  }

  .ft-col ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .ft-col a {
    text-decoration: none;
    font-size: 13.5px;
    color: var(--text-2);
    transition: color 0.2s;
    line-height: 1;
  }

  .ft-col a:hover { color: var(--text-1); }

  .ft-bottom {
    max-width: 1100px;
    margin: 0 auto;
    padding-top: 28px;
    border-top: 1px solid rgba(255,255,255,0.05);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }

  .ft-copy, .ft-made {
    font-size: 12px;
    color: var(--text-3);
    margin: 0;
  }

  @media (max-width: 768px) {
    .ft-wrap { grid-template-columns: 1fr; gap: 48px; }
    .ft-nav { gap: 40px; flex-wrap: wrap; }
    .ft-bottom { flex-direction: column; text-align: center; }
  }
</style>
