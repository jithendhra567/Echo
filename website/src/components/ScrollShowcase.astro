---
const pillars = [
  {
    id: 'launcher',
    tag: 'Launcher',
    hotkey: '⌘ Space',
    title: 'Search everything',
    body: 'Apps, browser tabs, calculations, and the web — ranked by how you actually work.',
    accent: '#818cf8',
    accentDim: 'rgba(99,102,241,0.15)',
    icon: '🔍',
  },
  {
    id: 'clipboard',
    tag: 'Clipboard',
    hotkey: '⌘⇧V',
    title: 'Never lose a copy',
    body: 'Every text snippet, link, and image — searchable, pinnable, and draggable anywhere.',
    accent: '#a78bfa',
    accentDim: 'rgba(167,139,250,0.15)',
    icon: '📋',
  },
  {
    id: 'notch',
    tag: 'Notch',
    hotkey: 'Hover',
    title: 'Live in your notch',
    body: 'Now playing, file tray, clock, and calendar — always visible, never in the way.',
    accent: '#ec4899',
    accentDim: 'rgba(236,72,153,0.15)',
    icon: '◼',
  },
];
---

<section id="scroll-showcase" aria-labelledby="ss-title">
  <div class="ss-pin-wrap">
    <div class="ss-sticky">

      <!-- Background glow -->
      <div class="ss-glow" aria-hidden="true"></div>

      <!-- Section label (updates with scroll) -->
      <div class="ss-header">
        <span class="section-eyebrow">Three tools</span>
        <h2 id="ss-title" class="section-h2">
          One app.<br />
          <em class="grad" style="font-style:normal;">Zero clutter.</em>
        </h2>
      </div>

      <!-- 3D stage -->
      <div class="ss-stage" id="ss-stage">
        <div class="ss-scene" id="ss-scene">

          {pillars.map((p, i) => (
            <article
              class="ss-card glass"
              data-pillar={p.id}
              data-index={i}
              style={`--card-accent:${p.accent}; --card-dim:${p.accentDim};`}
            >
              <div class="ss-card-inner">
                <div class="ss-card-tag" style={`color:${p.accent}; background:${p.accentDim};`}>
                  {p.tag}
                </div>
                <div class="ss-card-icon" aria-hidden="true">{p.icon}</div>
                <h3 class="ss-card-title">{p.title}</h3>
                <p class="ss-card-body">{p.body}</p>
                <kbd class="ss-hotkey">{p.hotkey}</kbd>

                {p.id === 'launcher' && (
                  <div class="ss-mini-ui" aria-hidden="true">
                    <div class="mini-row selected"><span>🎨</span> Figma <span class="mini-ret">↵</span></div>
                    <div class="mini-row"><span>💻</span> VS Code</div>
                    <div class="mini-row calc"><span>=</span> 100 USD → 92.14 EUR</div>
                  </div>
                )}

                {p.id === 'clipboard' && (
                  <div class="ss-mini-ui" aria-hidden="true">
                    <div class="mini-row selected"><span>T</span> npm install tailwindcss</div>
                    <div class="mini-row"><span>🔗</span> figma.com/file/...</div>
                    <div class="mini-row"><span>🖼</span> screenshot.png</div>
                  </div>
                )}

                {p.id === 'notch' && (
                  <div class="ss-mini-ui notch-ui" aria-hidden="true">
                    <div class="notch-bar">
                      <span class="np-dot"></span>
                      <span>♫ Fleetwood Mac</span>
                    </div>
                    <div class="mini-row"><span>📁</span> 3 files in tray</div>
                    <div class="mini-row"><span>🕐</span> 13:05 · Good afternoon</div>
                  </div>
                )}
              </div>
              <div class="ss-card-glow" aria-hidden="true"></div>
            </article>
          ))}

        </div>
      </div>

      <!-- Progress indicators -->
      <div class="ss-progress" role="tablist" aria-label="Feature pillars">
        {pillars.map((p, i) => (
          <button
            class="ss-dot"
            data-dot={i}
            role="tab"
            aria-selected={i === 0 ? 'true' : 'false'}
            aria-label={p.tag}
          >
            <span class="ss-dot-label">{p.tag}</span>
          </button>
        ))}
      </div>

      <!-- Scroll hint -->
      <div class="ss-scroll-hint" id="ss-scroll-hint" aria-hidden="true">
        <span>Keep scrolling</span>
        <div class="ss-scroll-line"></div>
      </div>

    </div>
  </div>
</section>

<style>
  #scroll-showcase {
    position: relative;
  }

  .ss-pin-wrap {
    height: 400vh;
    position: relative;
  }

  .ss-sticky {
    position: sticky;
    top: 0;
    height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    padding: 80px 24px 40px;
  }

  .ss-glow {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 60% 50% at 50% 50%, rgba(139,92,246,0.12), transparent 70%);
    pointer-events: none;
  }

  .ss-header {
    text-align: center;
    margin-bottom: 32px;
    z-index: 2;
    position: relative;
  }

  .section-eyebrow {
    display: inline-block;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 12px;
  }

  .section-h2 {
    font-size: clamp(28px, 4vw, 44px);
    font-weight: 800;
    letter-spacing: -0.035em;
    line-height: 1.08;
    color: #fafafa;
    margin: 0;
  }

  /* 3D stage */
  .ss-stage {
    perspective: 1200px;
    perspective-origin: 50% 50%;
    width: 100%;
    max-width: 900px;
    height: 420px;
    position: relative;
    z-index: 2;
  }

  .ss-scene {
    position: relative;
    width: 100%;
    height: 100%;
    transform-style: preserve-3d;
  }

  .ss-card {
    position: absolute;
    width: min(340px, 88vw);
    left: 50%;
    top: 50%;
    margin-left: calc(min(340px, 88vw) / -2);
    margin-top: -180px;
    transform-style: preserve-3d;
    will-change: transform, opacity;
    backface-visibility: hidden;
    overflow: hidden;
    padding: 0;
    border-color: rgba(255,255,255,0.08);
    transition: border-color 0.3s, box-shadow 0.3s;
  }

  .ss-card-inner {
    padding: 28px;
    position: relative;
    z-index: 1;
  }

  .ss-card-glow {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 50% 0%, var(--card-dim), transparent 70%);
    pointer-events: none;
    opacity: 0.6;
  }

  .ss-card-tag {
    display: inline-block;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 4px 10px;
    border-radius: 100px;
    margin-bottom: 16px;
  }

  .ss-card-icon {
    font-size: 32px;
    margin-bottom: 12px;
    line-height: 1;
  }

  .ss-card-title {
    font-size: 22px;
    font-weight: 800;
    color: #fafafa;
    letter-spacing: -0.03em;
    margin: 0 0 8px;
    line-height: 1.2;
  }

  .ss-card-body {
    font-size: 14px;
    color: #71717a;
    line-height: 1.6;
    margin: 0 0 16px;
  }

  .ss-hotkey {
    display: inline-block;
    padding: 4px 12px;
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 6px;
    font-size: 12px;
    color: #a1a1aa;
    font-family: var(--font);
    margin-bottom: 16px;
  }

  /* Mini UI previews inside cards */
  .ss-mini-ui {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 12px;
    background: rgba(0,0,0,0.25);
    border: 1px solid rgba(255,255,255,0.06);
    border-radius: 10px;
  }

  .mini-row {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 6px 8px;
    border-radius: 6px;
    font-size: 11px;
    color: #71717a;
    font-family: 'SF Mono', 'Fira Code', monospace;
  }

  .mini-row.selected {
    background: rgba(167,139,250,0.1);
    color: #fafafa;
    border-left: 2px solid var(--card-accent, #a78bfa);
  }

  .mini-row.calc { color: #34d399; font-weight: 600; }
  .mini-ret { margin-left: auto; color: var(--card-accent); font-weight: 700; }

  .notch-bar {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 12px;
    background: #1c1c22;
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 100px;
    font-size: 11px;
    color: #a1a1aa;
    margin-bottom: 4px;
  }

  .np-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: #ec4899;
    box-shadow: 0 0 6px rgba(236,72,153,0.8);
    animation: pulse-dot 2s ease-in-out infinite;
  }

  @keyframes pulse-dot {
    0%, 100% { opacity: 1; }
    50%       { opacity: 0.5; }
  }

  /* Progress dots */
  .ss-progress {
    display: flex;
    gap: 24px;
    margin-top: 36px;
    z-index: 2;
  }

  .ss-dot {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
  }

  .ss-dot::before {
    content: '';
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: rgba(255,255,255,0.15);
    transition: all 0.35s ease;
  }

  .ss-dot.active::before {
    width: 28px;
    border-radius: 4px;
    background: var(--accent);
    box-shadow: 0 0 16px rgba(139,92,246,0.5);
  }

  .ss-dot-label {
    font-size: 10px;
    font-weight: 600;
    color: #52525b;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    transition: color 0.3s;
  }

  .ss-dot.active .ss-dot-label { color: #a78bfa; }

  .ss-scroll-hint {
    position: absolute;
    bottom: 32px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    color: #3f3f46;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    opacity: 1;
    transition: opacity 0.4s;
  }

  .ss-scroll-hint.hidden { opacity: 0; pointer-events: none; }

  .ss-scroll-line {
    width: 1px;
    height: 32px;
    background: linear-gradient(to bottom, rgba(255,255,255,0.12), transparent);
    animation: ss-line-pulse 2s ease-in-out infinite;
  }

  @keyframes ss-line-pulse {
    0%, 100% { transform: scaleY(1); opacity: 1; }
    50%       { transform: scaleY(0.6); opacity: 0.4; }
  }

  @media (max-width: 640px) {
    .ss-pin-wrap { height: 350vh; }
    .ss-stage { height: 380px; }
    .ss-card { width: 92vw; margin-left: -46vw; }
    .ss-progress { gap: 16px; }
    .ss-dot-label { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .ss-pin-wrap { height: auto; }
    .ss-sticky { position: relative; height: auto; min-height: 100vh; }
    .ss-scene { display: flex; flex-direction: column; gap: 24px; align-items: center; height: auto; }
    .ss-card {
      position: relative;
      left: auto; top: auto;
      margin: 0;
      transform: none !important;
      opacity: 1 !important;
    }
    .ss-scroll-hint { display: none; }
  }
</style>
