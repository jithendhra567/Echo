---
---

<header id="nav" role="banner">
  <nav class="nav-inner" aria-label="Main navigation">
    <a href="/" class="nav-logo" aria-label="Echo home">
      <svg width="26" height="26" viewBox="0 0 28 28" fill="none" aria-hidden="true">
        <path d="M6 14 A10 10 0 0 1 22 14" stroke="#a78bfa" stroke-width="2.2" stroke-linecap="round" opacity="0.35"/>
        <path d="M9 14 A7  7  0 0 1 19 14" stroke="#a78bfa" stroke-width="2.2" stroke-linecap="round" opacity="0.65"/>
        <path d="M12 14 A4  4  0 0 1 16 14" stroke="#a78bfa" stroke-width="2.2" stroke-linecap="round"/>
      </svg>
      <span>Echo</span>
    </a>

    <ul class="nav-links" role="list">
      <li><a href="#launcher">Launcher</a></li>
      <li><a href="#clipboard">Clipboard</a></li>
      <li><a href="#notch">Notch</a></li>
      <li><a href="#features">Features</a></li>
    </ul>

    <a href="#download" class="nav-cta" aria-label="Download Echo">Download</a>

    <button class="nav-menu-btn" aria-label="Toggle menu" aria-expanded="false" aria-controls="mobile-menu">
      <span></span><span></span>
    </button>
  </nav>

  <div id="mobile-menu" class="mobile-menu" hidden aria-label="Mobile navigation">
    <a href="#launcher">Launcher</a>
    <a href="#clipboard">Clipboard</a>
    <a href="#notch">Notch</a>
    <a href="#features">Features</a>
    <a href="#download" class="mobile-cta">Download for Mac</a>
  </div>
</header>

<style>
  header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    transition: background 0.3s, backdrop-filter 0.3s, border-color 0.3s;
    border-bottom: 1px solid transparent;
  }

  header.scrolled {
    background: rgba(5,5,7,0.75);
    backdrop-filter: blur(20px) saturate(160%);
    -webkit-backdrop-filter: blur(20px) saturate(160%);
    border-bottom-color: rgba(255,255,255,0.06);
  }

  .nav-inner {
    max-width: 1160px;
    margin: 0 auto;
    padding: 0 24px;
    height: 60px;
    display: flex;
    align-items: center;
    gap: 40px;
  }

  .nav-logo {
    display: flex;
    align-items: center;
    gap: 9px;
    text-decoration: none;
    color: var(--text-1);
    font-size: 15px;
    font-weight: 700;
    letter-spacing: -0.01em;
    flex-shrink: 0;
  }

  .nav-links {
    display: flex;
    list-style: none;
    margin: 0;
    padding: 0;
    gap: 30px;
    flex: 1;
    justify-content: center;
  }

  .nav-links a {
    text-decoration: none;
    color: var(--text-2);
    font-size: 13.5px;
    font-weight: 500;
    transition: color 0.2s;
  }

  .nav-links a:hover { color: var(--text-1); }

  .nav-cta {
    padding: 8px 20px;
    background: rgba(255,255,255,0.08);
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: 100px;
    color: var(--text-1);
    font-size: 13px;
    font-weight: 600;
    text-decoration: none;
    transition: background 0.2s, border-color 0.2s;
    flex-shrink: 0;
    white-space: nowrap;
  }

  .nav-cta:hover {
    background: rgba(255,255,255,0.14);
    border-color: rgba(255,255,255,0.2);
  }

  .nav-menu-btn {
    display: none;
    flex-direction: column;
    gap: 6px;
    padding: 10px;
    background: none;
    border: none;
    cursor: pointer;
    margin-left: auto;
  }

  .nav-menu-btn span {
    display: block;
    width: 20px;
    height: 1.5px;
    background: var(--text-2);
    border-radius: 2px;
  }

  .mobile-menu {
    display: flex;
    flex-direction: column;
    padding: 8px 24px 24px;
    background: rgba(5,5,7,0.97);
    border-bottom: 1px solid rgba(255,255,255,0.06);
    gap: 2px;
  }

  .mobile-menu a {
    padding: 13px 0;
    color: var(--text-2);
    text-decoration: none;
    font-size: 16px;
    font-weight: 500;
    border-bottom: 1px solid rgba(255,255,255,0.04);
    transition: color 0.2s;
  }

  .mobile-menu a:hover { color: var(--text-1); }
  .mobile-menu a:last-child { border: none; }

  .mobile-cta {
    margin-top: 12px;
    padding: 14px !important;
    background: rgba(167,139,250,0.12);
    border: 1px solid rgba(167,139,250,0.25) !important;
    border-radius: 12px;
    color: #c4b5fd !important;
    text-align: center;
    font-weight: 600 !important;
  }

  @media (max-width: 768px) {
    .nav-links, .nav-cta { display: none; }
    .nav-menu-btn { display: flex; }
  }
</style>

<script>
  const header = document.getElementById('nav')!;
  window.addEventListener('scroll', () => {
    header.classList.toggle('scrolled', window.scrollY > 20);
  }, { passive: true });

  const btn  = header.querySelector('.nav-menu-btn') as HTMLButtonElement;
  const menu = document.getElementById('mobile-menu')!;
  btn.addEventListener('click', () => {
    const open = !menu.hidden;
    menu.hidden = open;
    btn.setAttribute('aria-expanded', String(!open));
  });

  menu.querySelectorAll('a').forEach(a => {
    a.addEventListener('click', () => {
      menu.hidden = true;
      btn.setAttribute('aria-expanded', 'false');
    });
  });
</script>
