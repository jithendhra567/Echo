---
import MediaFrame from './MediaFrame.astro';
---

<section id="hero" aria-label="Hero">
  <div class="hero-sticky" id="hero-sticky">
    <div class="hero-bg-glow" aria-hidden="true"></div>
    <div class="hero-bg-grid" aria-hidden="true"></div>

    <div class="hero-copy" id="hero-copy">
      <div class="hero-badge" id="hero-badge">
        <span class="badge-dot" aria-hidden="true"></span>
        Free for macOS · 100% local
      </div>

      <h1 class="hero-h1" id="hero-title">
        Clipboard. Launcher. Notch.<br />
        <em class="grad" style="font-style:normal;">One keystroke.</em>
      </h1>

      <p class="hero-sub" id="hero-sub">
        Echo lives in your menu bar. Search any app or tab, recall
        everything you've copied, and put your notch to work.
      </p>

      <div class="hero-ctas" id="hero-ctas">
        <a href="#download" class="btn-primary">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M8 2v8M5 7l3 3 3-3" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M2 13h12" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
          </svg>
          Download for Mac
        </a>
        <a href="#launcher" class="btn-secondary">Watch it work</a>
      </div>
    </div>

    <!-- Video in 3D frame — straightens on scroll -->
    <div class="hero-stage persp" id="hero-stage">
      <div class="hero-screen preserve-3d" id="hero-screen">
        <MediaFrame
          video
          src="/media/hero-demo.mp4"
          alt="Echo demo: launching apps, searching the clipboard, and using the notch"
          label="Drop hero-demo.mp4 into website/public/media/"
          class="hero-frame"
        />
        <div class="hero-screen-glow" aria-hidden="true"></div>
      </div>
    </div>

    <div class="hero-scroll-hint" id="hero-scroll-hint" aria-hidden="true">
      <div class="scroll-line"></div>
      <span>Scroll</span>
    </div>
  </div>
</section>

<style>
  #hero {
    position: relative;
  }

  .hero-sticky {
    position: relative;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 110px 24px 48px;
    overflow: hidden;
    gap: 48px;
  }

  .hero-bg-glow {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 80% 50% at 50% -10%, rgba(139,92,246,0.22) 0%, transparent 65%),
      radial-gradient(ellipse 40% 30% at 15% 70%, rgba(236,72,153,0.05) 0%, transparent 60%),
      radial-gradient(ellipse 40% 30% at 85% 70%, rgba(56,189,248,0.05) 0%, transparent 60%);
    pointer-events: none;
  }

  .hero-bg-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255,255,255,0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,0.03) 1px, transparent 1px);
    background-size: 72px 72px;
    pointer-events: none;
    mask-image: radial-gradient(ellipse 90% 70% at 50% 30%, black 25%, transparent 75%);
    -webkit-mask-image: radial-gradient(ellipse 90% 70% at 50% 30%, black 25%, transparent 75%);
  }

  .hero-copy {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    max-width: 760px;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 7px 16px;
    background: rgba(167,139,250,0.08);
    border: 1px solid rgba(167,139,250,0.2);
    border-radius: 100px;
    font-size: 12.5px;
    font-weight: 500;
    color: #c4b5fd;
    margin-bottom: 26px;
  }

  .badge-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 8px rgba(167,139,250,0.8);
  }

  .hero-h1 {
    font-size: clamp(40px, 6.5vw, 78px);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.045em;
    color: var(--text-1);
    margin: 0 0 22px;
  }

  .hero-sub {
    font-size: clamp(16px, 2vw, 19px);
    line-height: 1.65;
    color: var(--text-2);
    margin: 0 0 32px;
    max-width: 540px;
  }

  .hero-ctas {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
    justify-content: center;
  }

  /* 3D video stage */
  .hero-stage {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 880px;
  }

  .hero-screen {
    position: relative;
    transform-origin: 50% 100%;
  }

  :global(.hero-frame) {
    border-radius: 20px;
    aspect-ratio: 16 / 10;
  }

  :global(.hero-frame .mf-media) {
    aspect-ratio: 16 / 10;
    object-fit: cover;
  }

  .hero-screen-glow {
    position: absolute;
    left: 8%;
    right: 8%;
    bottom: -32px;
    height: 70px;
    background: radial-gradient(ellipse at center, rgba(139,92,246,0.28), transparent 70%);
    filter: blur(28px);
    pointer-events: none;
  }

  .hero-scroll-hint {
    position: absolute;
    bottom: 22px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    color: var(--text-3);
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    z-index: 3;
  }

  .scroll-line {
    width: 1px;
    height: 32px;
    background: linear-gradient(to bottom, rgba(255,255,255,0.18), transparent);
  }

  @media (max-width: 640px) {
    .hero-sticky { padding: 100px 20px 60px; gap: 36px; }
    .hero-ctas { flex-direction: column; width: 100%; }
    .hero-ctas a { width: 100%; justify-content: center; }
  }
</style>
